# Copy to .env for local development. Replace SESSION_SECRET before any public deployment.
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms_registry?schema=public"
TEST_DATABASE_URL="postgresql://sms:sms@localhost:5433/sms_registry_test?schema=public"
SESSION_SECRET="development-only-secret-change-me-32-chars-minimum"
ENABLE_DEMO_SESSION=true
COOKIE_SECURE=auto
ORGANIZATION_TIMEZONE=Europe/London
APP_CURRENCY=GBP
UPLOAD_DIR=.uploads
MAX_UPLOAD_MB=4
